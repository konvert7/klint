{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    "./tools/semantic-release-native-npm.js",
    "./tools/semantic-release-root-npm.js",
    "./tools/semantic-release-crates.js",
    [
      "@semantic-release/git",
      {
        "assets": [
          "package.json",
          "crates/klint-rs/Cargo.toml",
          "Cargo.lock",
          "CHANGELOG.md",
          "klint.schema.json",
          "klint.schema.yaml"
        ]
      }
    ],
    "@semantic-release/github"
  ]
}
