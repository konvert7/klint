    "expected": {
      "violations": [
        {
          "file": "src/big.ts",
          "line": 3,
          "rule": "arch/max-lines",
          "message": "File exceeds the maximum of 2 lines",
          "severity": "error",
          "fix": null
        }
      ],
      "summary": {
        "errors": 1,
        "warnings": 0
      }
    }
