{
  "name": "@konvert7/klint",
  "version": "0.37.1",
  "description": "Architecture-as-Code linter for TypeScript. Enforce layer boundaries, import rules, and singleton patterns in YAML.",
  "type": "module",
  "bin": {
    "klint": "bin/klint.js"
  },
  "files": [
    "bin",
    "README.md",
    "klint.schema.json",
    "klint.schema.yaml"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "architecture",
    "linter",
    "typescript",
    "bun",
    "agent",
    "agentic",
    "arch-as-code"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konvert7/klint.git"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "pack:check": "bun tests/pack-check.ts",
    "native:stage": "bun tests/stage-native-binary.ts",
    "native:smoke": "bun tests/smoke-native-binary.ts",
    "python:stage": "bun tests/stage-python-wheel.ts",
    "python:smoke": "bun tests/smoke-python-wheel.ts",
    "nuget:stage": "bun tests/stage-nuget-binary.ts",
    "nuget:smoke": "bun tests/smoke-nuget-tool.ts",
    "native:release:dry-run": "bun tools/prepare-native-release.ts --version 0.0.0-dry-run",
    "nuget:release:dry-run": "bun tools/prepare-nuget-release.ts --version 0.0.0-dry-run",
    "check": "biome check",
    "check-write": "biome check --write",
    "knip": "knip-bun",
    "klint": "cargo run --quiet -p klint-rs --",
    "jscpd": "jscpd --noTips",
    "schema": "cargo run --quiet -p klint-rs --example generate_schema -- $npm_package_version",
    "lint-staged": "lint-staged",
    "prepare": "bun .husky/install.mjs"
  },
  "lint-staged": {
    "*.ts": [
      "bun run check"
    ]
  },
  "optionalDependencies": {
    "@konvert7/klint-darwin-arm64": "*",
    "@konvert7/klint-darwin-x64": "*",
    "@konvert7/klint-linux-x64": "*",
    "@konvert7/klint-win32-x64": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@types/bun": "latest",
    "@types/node": "latest",
    "husky": "^9.1.7",
    "jscpd": "4.2.3",
    "knip": "^6.9.0",
    "lint-staged": "^15.5.2",
    "semantic-release": "^25.0.3",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0"
  },
  "directories": {
    "test": "tests"
  },
  "author": "Konvert7",
  "bugs": {
    "url": "https://github.com/konvert7/klint/issues"
  },
  "homepage": "https://github.com/konvert7/klint#readme"
}
