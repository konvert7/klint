{
  "baseBranch": "main",
  "prepare": "bun install",
  "gate": [
    { "name": "fmt", "run": "cargo fmt --check", "roles": ["test-writer", "code-writer", "debugger"] },
    { "name": "lint", "run": "bun run check", "roles": ["test-writer", "code-writer", "debugger"] },
    { "name": "klint", "run": "bun run klint", "roles": ["test-writer", "code-writer", "debugger"] },
    { "name": "types", "run": "bun run type-check" },
    { "name": "knip", "run": "bun run knip" },
    { "name": "jscpd", "run": "bun run jscpd" },
    { "name": "clippy", "run": "cargo clippy -p klint-rs --all-targets -- -D warnings" },
    { "name": "tests", "run": "cargo test -p klint-rs --no-fail-fast && bun run test" }
  ]
}
