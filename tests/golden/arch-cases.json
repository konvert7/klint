    "expected": {
      "violations": [
        {
          "file": "assets/skills/demo/index.ts",
          "line": 2,
          "rule": "arch/imports",
          "message": "Use runtime boundary",
          "severity": "error",
          "fix": null
        }
      ],
      "summary": {
        "errors": 1,
        "warnings": 0
      }
    }
  },
  {
    "name": "arch imports resolves tsconfig path aliases",
    "tsconfig": {
      "compilerOptions": {
        "baseUrl": ".",
        "paths": {
          "@/*": [
            "src/*"
          ]
        }
      }
    },
    "config": {
      "include": [
        "."
      ],
      "rules": {},
      "arch": {
        "layers": {
          "skills": [
            "assets/skills/**"
          ],
          "core": [
            "src/**"
          ]
        },
        "imports": [
          {
            "from": "skills",
            "deny": "core",
            "message": "No repo source imports from skills",
            "severity": "warn"
          }
        ]
      }
    },
    "files": {
      "assets/skills/demo/index.ts": "import { foo } from \"@/lib/utils\";\nexport const value = foo;\n",
      "src/lib/utils.ts": "export const foo = 1;\n"
    },
    "expected": {
      "violations": [
        {
          "file": "assets/skills/demo/index.ts",
          "line": 1,
          "rule": "arch/imports",
          "message": "No repo source imports from skills",
          "severity": "warn",
          "fix": null
        }
      ],
      "summary": {
        "errors": 0,
        "warnings": 1
      }
    }
  },
  {
