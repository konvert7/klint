{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bun .agents/hooks/check.ts" },
          { "type": "command", "command": "bun .agents/hooks/type-check.ts" },
          { "type": "command", "command": "bun .agents/hooks/rust-format.ts" },
          { "type": "command", "command": "bun .agents/hooks/rust-check.ts" },
          { "type": "command", "command": "bun .agents/hooks/rust-clippy.ts" },
          { "type": "command", "command": "bun .agents/hooks/pack-check.ts" },
          { "type": "command", "command": "bun .agents/hooks/jscpd.ts" },
          { "type": "command", "command": "bun .agents/hooks/knip.ts" },
          { "type": "command", "command": "bun .agents/hooks/klint.ts" },
          { "type": "command", "command": "bun .agents/hooks/madge.ts" },
          { "type": "command", "command": "bun .agents/hooks/lf.ts" },
          { "type": "command", "command": "bun .agents/hooks/exact-versions.ts" },
          { "type": "command", "command": "bun .agents/hooks/lock-check.ts" },
          { "type": "command", "command": "bun .agents/hooks/secretlint.ts" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bun run check *)",
      "Bash(bun run check-write *)",
      "Bash(bun run type-check *)",
      "Bash(bun run pack:check *)",
      "Bash(bun run knip *)",
      "Bash(bun test *)",
      "Bash(bun run klint *)",
      "Bash(cargo fmt *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo test *)"
    ]
  }
}
