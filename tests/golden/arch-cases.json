      "src/session.ts": "export const getUserId = () => \"1\";\n"
    },
    "expected": {
      "violations": [
        {
          "file": "src/dao/users.ts",
          "line": 1,
          "rule": "arch/imports",
          "message": "DAO must not read request state",
          "severity": "error",
          "fix": null
        },
        {
          "file": "src/dao/users.ts",
          "line": 2,
          "rule": "arch/imports",
          "message": "DAO must not read request state",
          "severity": "error",
          "fix": null
        },
        {
          "file": "src/dao/users.ts",
          "line": 7,
          "rule": "arch/imports",
          "message": "DAO must not read request state",
          "severity": "error",
          "fix": null
        }
      ],
      "summary": {
        "errors": 3,
        "warnings": 0
      }
    }
